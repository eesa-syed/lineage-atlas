{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lineage-atlas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "lineage-atlas-built",
      "runtimeExecutable": "node",
