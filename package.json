{
  "name": "lineage-atlas",
  "version": "1.0.0",
  "private": false,
  "description": "A DAG documentation explorer for data pipelines: searchable lineage, asset schemas and prose logic flows in one shareable file.",
  "bin": {
    "lineage-atlas": "bin/lineage-atlas.mjs"
  },
  "files": [
    "bin/",
    "server/dist/",
    "web/dist/",
    "docs/",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run check:version && npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "check:version": "node scripts/check-version.mjs",
    "pipelines": "npm run pipelines -w server",
    "export": "npm run export -w server --",
    "import": "npm run import -w server --",
    "validate": "npm run validate -w server --",
    "from-dbt": "npm run from-dbt -w server --",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "express": "^4.22.2",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "license": "MIT",
  "keywords": [
    "dag",
    "data-lineage",
    "data-pipeline",
    "documentation",
    "data-catalog",
    "metadata",
    "graph",
    "observability"
  ],
  "homepage": "https://github.com/eesa-syed/lineage-atlas#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eesa-syed/lineage-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/eesa-syed/lineage-atlas/issues"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
